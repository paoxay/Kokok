<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/shared_intercity_flow" app:startDestination="@id/entry"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <fragment android:name="com.taxsee.shared.feature.shared_intercity.SharedIntercityEntryFragment" android:id="@id/entry">
        <argument android:name="order_id" android:defaultValue="-1L" app:argType="long" />
        <argument android:name="isFromAssignedOrder" android:defaultValue="false" app:argType="boolean" />
        <action android:id="@id/action_entry_to_orders" app:destination="@id/orders" app:popUpTo="@id/entry" app:popUpToInclusive="true" />
        <action android:id="@id/action_entry_to_order" app:destination="@id/order" app:popUpTo="@id/entry" app:popUpToInclusive="true" />
    </fragment>
    <fragment android:name="com.taxsee.shared.feature.shared_intercity.orders.ui.SharedIntercityOrdersFragment" android:id="@id/orders">
        <action android:id="@id/action_orders_to_onboarding" app:destination="@id/onboarding" />
        <action android:id="@id/action_order_to_form" app:destination="@id/form" />
        <action android:id="@id/action_orders_to_order" app:destination="@id/order" />
    </fragment>
    <fragment android:name="com.taxsee.shared.feature.shared_intercity.onboarding.ui.SharedIntercityOnboardingFragment" android:id="@id/onboarding">
        <argument android:name="type" app:argType="string" />
    </fragment>
    <fragment android:name="com.taxsee.shared.feature.shared_intercity.form.ui.SharedIntercityFormFragment" android:id="@id/form">
        <argument android:name="order_id" android:defaultValue="-1L" app:argType="long" />
        <argument android:name="start_address" android:defaultValue="@null" app:argType="com.taxsee.feature.pick_address.model.waypoint.Waypoint" app:nullable="true" />
        <argument android:name="end_address" android:defaultValue="@null" app:argType="com.taxsee.feature.pick_address.model.waypoint.Waypoint" app:nullable="true" />
        <argument android:name="car_id" android:defaultValue="-1L" app:argType="long" />
        <argument android:name="seats_count" android:defaultValue="-1" app:argType="integer" />
        <argument android:name="date_start" android:defaultValue="-1L" app:argType="long" />
        <argument android:name="seat_price" android:defaultValue="-1" app:argType="integer" />
        <argument android:name="comment" android:defaultValue="" app:argType="string" />
        <action android:id="@id/action_form_to_onboarding" app:destination="@id/onboarding" />
    </fragment>
    <fragment android:name="com.taxsee.shared.feature.shared_intercity.order.details.ui.SharedIntercityOrderDetailsFragment" android:id="@id/order">
        <argument android:name="order_id" app:argType="long" />
        <argument android:name="isFromAssignedOrder" android:defaultValue="false" app:argType="boolean" />
        <action android:id="@id/action_order_to_onboarding" app:destination="@id/onboarding" />
        <action android:id="@id/action_order_to_order_map" app:destination="@id/order_map" />
        <action android:id="@id/action_order_to_shared_current_order" app:destination="@id/shared_intercity_current_order">
            <argument android:name="isFromAssignedOrder" app:argType="boolean" />
        </action>
        <action android:id="@id/action_order_to_order_actions" app:destination="@id/order_actions" />
        <action android:id="@id/action_details_to_form" app:destination="@id/form" />
    </fragment>
    <fragment android:name="com.taxsee.shared.feature.shared_intercity.order.map.ui.SharedIntercityOrderMapFragment" android:id="@id/order_map">
        <argument android:name="order_id" app:argType="long" />
        <argument android:name="isFromAssignedOrder" android:defaultValue="false" app:argType="boolean" />
        <action android:id="@id/action_order_map_to_shared_current_order" app:destination="@id/shared_intercity_current_order">
            <argument android:name="isFromAssignedOrder" app:argType="boolean" />
        </action>
    </fragment>
    <dialog android:name="com.taxsee.shared.feature.shared_intercity.order.actions.ui.SharedIntercityOrderActionsFragment" android:id="@id/order_actions">
        <argument android:name="order_id" app:argType="long" />
        <argument android:name="isFromAssignedOrder" android:defaultValue="false" app:argType="boolean" />
        <action android:id="@id/action_to_orders" app:destination="@id/orders" app:popUpTo="@id/orders" app:popUpToInclusive="true" />
    </dialog>
</navigation>