<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:background="@color/screen_with_cards_background" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <include android:visibility="gone" layout="@layout/layout_timer_auto_assignment" />
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <include layout="@layout/view_fragment_appbar" />
        <include android:id="@id/system_problem_warning" android:visibility="gone" layout="@layout/system_problem_warning" />
        <FrameLayout android:layout_width="fill_parent" android:layout_height="0.0dip" android:layout_weight="1.0">
            <androidx.recyclerview.widget.RecyclerView android:id="@id/tarrif_list" android:background="@color/card_background" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            <include android:id="@id/connectivity_conditions" layout="@layout/layout_connectivity_conditions" />
        </FrameLayout>
        <com.google.android.material.card.MaterialCardView android:id="@id/v_order_access_hint" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content">
