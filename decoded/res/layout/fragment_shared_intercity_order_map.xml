<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <include android:id="@id/appbar" layout="@layout/view_fragment_appbar" />
    <androidx.fragment.app.FragmentContainerView android:id="@id/mapContainer" android:layout_width="fill_parent" android:layout_height="fill_parent" />
